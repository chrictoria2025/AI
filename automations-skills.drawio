        </mxCell>
        <mxCell id="DrOSEwYW1EBVrWRWoFKn-60" value="&lt;font style=&#39;font-size:10px;&#39;&gt;&lt;b&gt;Adjusted Score&lt;/b&gt; = CVSS Base + Internet Exposed (±1) + KEV (±1) + Criticality (±1) + Exploit (+1) + PCI Asset (+1)&lt;br&gt;&lt;br&gt;&lt;b&gt;P1&lt;/b&gt; ≥ 9.0 &amp;nbsp;|&amp;nbsp; &lt;b&gt;P2&lt;/b&gt; 7.0–8.9 &amp;nbsp;|&amp;nbsp; &lt;b&gt;P3&lt;/b&gt; 4.0–6.9 &amp;nbsp;|&amp;nbsp; &lt;b&gt;P4&lt;/b&gt; &amp;lt; 4.0&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=none;strokeColor=none;" parent="DrOSEwYW1EBVrWRWoFKn-59" vertex="1">
          <mxGeometry x="20" y="30" width="520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="DrOSEwYW1EBVrWRWoFKn-61" value="DATA FLOW SUMMARY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=4;spacingTop=5;align=center;container=1;collapsible=0;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="410" y="1230" width="440" height="160" as="geometry" />
        </mxCell>
        <mxCell id="DrOSEwYW1EBVrWRWoFKn-62" value="&lt;font style=&#39;font-size:10px;&#39;&gt;❶ &lt;b&gt;Inspector/Security Hub&lt;/b&gt; scans ECR images in target accounts&lt;br&gt;❷ &lt;b&gt;Discovery Lambda&lt;/b&gt; (weekly) discovers ECS/ECR, stores inventory&lt;br&gt;❸ &lt;b&gt;Reporter Lambda&lt;/b&gt; (daily) reads inventory, queries Inspector&lt;br&gt;❹ Creates/updates/closes &lt;b&gt;Jira tickets&lt;/b&gt; with priority scoring&lt;br&gt;❺ Writes daily reports to &lt;b&gt;Google Sheets&lt;/b&gt; (merged multi-region)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;spacingLeft=5;" parent="DrOSEwYW1EBVrWRWoFKn-61" vertex="1">
          <mxGeometry x="10" y="30" width="420" height="120" as="geometry" />
        </mxCell>
