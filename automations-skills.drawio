        <mxCell id="arM-87f5tBUBMfA-Q8R3-93" value="&lt;b&gt;How the Skill Benefits the LLM-Driven Workflow&lt;/b&gt;" style="text;html=1;align=center;fontSize=13;fontColor=#BF360C;" parent="1" vertex="1">
          <mxGeometry x="790" y="2245" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="arM-87f5tBUBMfA-Q8R3-94" value="&lt;b&gt;1. Structured Guidance&lt;/b&gt;&lt;br&gt;8-step process prevents&lt;br&gt;the LLM from missing steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1;fontSize=9;" parent="1" vertex="1">
          <mxGeometry x="470" y="2270" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="arM-87f5tBUBMfA-Q8R3-95" value="&lt;b&gt;2. Baseline Alignment&lt;/b&gt;&lt;br&gt;Classification table maps&lt;br&gt;app type → correct defaults" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1;fontSize=9;" parent="1" vertex="1">
          <mxGeometry x="660" y="2270" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="arM-87f5tBUBMfA-Q8R3-96" value="&lt;b&gt;3. Dependency Enforcement&lt;/b&gt;&lt;br&gt;IDs cascade step-to-step&lt;br&gt;ensuring referential integrity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1;fontSize=9;" parent="1" vertex="1">
          <mxGeometry x="850" y="2270" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="arM-87f5tBUBMfA-Q8R3-97" value="&lt;b&gt;4. Reuse vs. Create&lt;/b&gt;&lt;br&gt;LLM checks existing resources&lt;br&gt;before creating new ones" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1;fontSize=9;" parent="1" vertex="1">
          <mxGeometry x="1040" y="2270" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="arM-87f5tBUBMfA-Q8R3-98" value="&lt;b&gt;5. Zero Trust Policy&lt;/b&gt;&lt;br&gt;Explicit ALLOW rule required&lt;br&gt;— no implicit access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1;fontSize=9;" parent="1" vertex="1">
          <mxGeometry x="1230" y="2270" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="arM-87f5tBUBMfA-Q8R3-99" value="&lt;b&gt;6. Built-in Verification&lt;/b&gt;&lt;br&gt;GET calls confirm every&lt;br&gt;resource before handoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=1;fontSize=9;" parent="1" vertex="1">
          <mxGeometry x="1420" y="2270" width="170" height="45" as="geometry" />
        </mxCell>
      </root>
