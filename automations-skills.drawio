        <mxCell id="dI0JzHXBnpPs2hffmBnN-56" value="Main workflow" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#90CAF9;" vertex="1" parent="1">
