        <mxCell id="arM-87f5tBUBMfA-Q8R3-63" value="&lt;b&gt;Benefit:&lt;/b&gt; LLM enforces correct&lt;br&gt;dependency chain — no orphan&lt;br&gt;resources or missing references" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
