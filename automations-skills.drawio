        <mxCell id="efOsK9inqy8JIb5-7ex9-45" value="&lt;b&gt;🧠 Embedded Domain Logic&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Priority evaluation, first-match-wins,&lt;br&gt;SSL→DLP dependency — domain&lt;br&gt;expertise baked into the prompt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="930" y="390" width="260" height="70" as="geometry" />
