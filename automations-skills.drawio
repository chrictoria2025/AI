        <mxCell id="arM-87f5tBUBMfA-Q8R3-71" value="&lt;b&gt;Benefit:&lt;/b&gt; Zero Trust by default —&lt;br&gt;no access until explicit policy&lt;br&gt;rule grants it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
