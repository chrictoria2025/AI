          </mxGeometry>
        </mxCell>
        <mxCell id="dI0JzHXBnpPs2hffmBnN-51" value="&lt;div style=&#39;text-align:left;font-size:10px&#39;&gt;&lt;b style=&#39;font-size:11px&#39;&gt;Report Visual Contract&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sticky header (Zscaler gradient)&lt;br&gt;→ Stat strip (Critical / Warning / Info / Cannot Audit)&lt;br&gt;→ Inventory line&lt;br&gt;→ Filter bar (search + category + severity + framework chips)&lt;br&gt;→ Finding cards (expand/collapse, sorted by severity)&lt;br&gt;→ Print stylesheet for clean PDF export&lt;br&gt;→ Footer with skill attribution&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#311B92;fontColor=#D1C4E9;strokeColor=#4527A0;arcSize=8;fontSize=10;align=left;spacingLeft=12;" vertex="1" parent="1">
