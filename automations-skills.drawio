        <mxCell id="xBpChCBXUIgInUoBrifL-89" value="&lt;b&gt;Multi-Region Variants&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:8px;&#39;&gt;Each service has 3 variants:&lt;br&gt;• legacy (legacyorgmetrics)&lt;br&gt;• US (chrisusorgmetrics)&lt;br&gt;• EU (chriseuorgmetrics)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;arcSize=8;align=left;spacingLeft=6;" parent="xBpChCBXUIgInUoBrifL-77" vertex="1">
