        <mxCell id="IybVh6bIDGtyAEBsr_gW-40" style="dashed=1;rounded=1;strokeColor=#999999;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-34" target="IybVh6bIDGtyAEBsr_gW-39">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-41" value="&lt;b&gt;Step 6: Present Diagnosis Report&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Structured report:&lt;br&gt;• Connector Group &amp; status summary&lt;br&gt;• API findings (keys, groups, segments)&lt;br&gt;• Root cause explanation&lt;br&gt;• Actionable remediation steps&lt;br&gt;• Escalation path if unresolved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="1340" width="210" height="120" as="geometry" />
