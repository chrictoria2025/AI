        <mxCell id="dI0JzHXBnpPs2hffmBnN-47" value="&lt;b&gt;Actionable Remediation&lt;/b&gt;&lt;br&gt;Each finding links to fix skill or doc section" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B5E20;fontColor=#FFFFFF;strokeColor=#388E3C;arcSize=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="1045" width="260" height="45" as="geometry" />
