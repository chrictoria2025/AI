        <mxCell id="dI0JzHXBnpPs2hffmBnN-49" value="&lt;div style=&#39;text-align:left;font-size:10px&#39;&gt;&lt;b style=&#39;font-size:12px&#39;&gt;Finding Structure&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;id&lt;/b&gt; — stable identifier&lt;br&gt;&lt;b&gt;category&lt;/b&gt; — 1 of 8 buckets&lt;br&gt;&lt;b&gt;severity&lt;/b&gt; — critical / warning / info / cannotAudit&lt;br&gt;&lt;b&gt;title&lt;/b&gt; — one-line summary&lt;br&gt;&lt;b&gt;evidence&lt;/b&gt; — resource names (max 10)&lt;br&gt;&lt;b&gt;docRef&lt;/b&gt; — baseline doc section&lt;br&gt;&lt;b&gt;remediation&lt;/b&gt; — how to fix&lt;br&gt;&lt;b&gt;heuristic&lt;/b&gt; — true if name-pattern based&lt;br&gt;&lt;b&gt;frameworks&lt;/b&gt; — NIST + CIS citations&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1A2E;fontColor=#E0E0E0;strokeColor=#7986CB;arcSize=8;fontSize=10;align=left;spacingLeft=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="610" y="730" width="220" height="200" as="geometry" />
        </mxCell>
