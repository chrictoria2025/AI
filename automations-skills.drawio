        <mxCell id="DbW1IiuRQzn9Q2EnQdVx-28" value="1. Create &lt;b&gt;User-Assigned&lt;br&gt;Managed Identity&lt;/b&gt; up front" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="DbW1IiuRQzn9Q2EnQdVx-27">
