        <mxCell id="DrOSEwYW1EBVrWRWoFKn-59" value="PRIORITY SCORING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;arcSize=4;spacingTop=5;align=center;container=1;collapsible=0;dashed=1;" parent="1" vertex="1">
