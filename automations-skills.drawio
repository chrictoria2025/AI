        <mxCell id="IybVh6bIDGtyAEBsr_gW-46" value="&lt;b&gt;✅ KEY BENEFITS&lt;/b&gt;&lt;br&gt;&lt;hr&gt;• &lt;b&gt;Structured triage:&lt;/b&gt; systematic&lt;br&gt;  elimination vs. guesswork&lt;br&gt;• &lt;b&gt;API-driven:&lt;/b&gt; LLM inspects&lt;br&gt;  live config via MCP tools&lt;br&gt;• &lt;b&gt;Auto-remediation:&lt;/b&gt; can fix&lt;br&gt;  provisioning keys directly&lt;br&gt;• &lt;b&gt;Runbook knowledge:&lt;/b&gt; CLI&lt;br&gt;  commands &amp; procedures embedded&lt;br&gt;• &lt;b&gt;Escalation path:&lt;/b&gt; logs to&lt;br&gt;  collect for Zscaler Support&lt;br&gt;• &lt;b&gt;Transparency:&lt;/b&gt; flags what&lt;br&gt;  API cannot observe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1000" y="1320" width="220" height="200" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-47" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-41" target="IybVh6bIDGtyAEBsr_gW-46">
