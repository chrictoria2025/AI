        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-48" value="&lt;b&gt;Healthy Connector Indicators&lt;/b&gt;&lt;br&gt;(LLM validates against these):&lt;br&gt;&lt;hr&gt;• Control: fohh_connection_connected&lt;br&gt;• Cert expiry &gt; 30 days&lt;br&gt;• Uptime continuously incrementing&lt;br&gt;• Broker connections &gt; 0, backed_off = 0&lt;br&gt;• Registered apps = alive apps" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
