        <mxCell id="dI0JzHXBnpPs2hffmBnN-10" value="&lt;b&gt;Segments&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:9px&#39;&gt;5 checks: health, wildcard, IP-only, no SG&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;strokeColor=#43A047;arcSize=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="730" y="550" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dI0JzHXBnpPs2hffmBnN-11" value="&lt;b&gt;Access Policy&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:9px&#39;&gt;6 checks: block-all, posture, contractor, discovery, crown-jewel, deception&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;strokeColor=#43A047;arcSize=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="615" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dI0JzHXBnpPs2hffmBnN-12" value="&lt;b&gt;Forwarding Policy&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:9px&#39;&gt;3 checks: no wildcard, bypass, SCIM scoped&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;strokeColor=#43A047;arcSize=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="615" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="dI0JzHXBnpPs2hffmBnN-13" value="&lt;b&gt;Timeout Policy&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:9px&#39;&gt;3 checks: auth range, idle floor, sensitive tight&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;strokeColor=#43A047;arcSize=10;fontSize=10;" vertex="1" parent="1">
