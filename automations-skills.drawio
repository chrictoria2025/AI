        <mxCell id="efOsK9inqy8JIb5-7ex9-47" value="&lt;b&gt;🚧 Scope Control&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;&quot;When NOT to use&quot; section prevents&lt;br&gt;the LLM from over-applying the skill&lt;br&gt;or confusing it with similar tasks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="930" y="560" width="260" height="70" as="geometry" />
