        <mxCell id="efOsK9inqy8JIb5-7ex9-46" value="&lt;b&gt;📋 Consistent Output Format&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Report template with examples ensures&lt;br&gt;structured, predictable responses&lt;br&gt;every invocation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=11;" vertex="1" parent="1">
