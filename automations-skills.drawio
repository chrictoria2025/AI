        <mxCell id="dI0JzHXBnpPs2hffmBnN-1" value="&lt;font color=&quot;#330000&quot;&gt;ZPA Audit Baseline Compliance — How the Skill Instructs the LLM&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="200" y="120" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="dI0JzHXBnpPs2hffmBnN-2" value="Read-only audit of a ZPA tenant against Zscaler ZPA Baseline Recommendations v1.0" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontColor=#99AAB5;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="155" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="dI0JzHXBnpPs2hffmBnN-3" value="&lt;b&gt;Step 1: Confirm Scope&lt;/b&gt;&lt;br&gt;Full audit or single category?&lt;br&gt;Parent tenant or microtenant?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A237E;fontColor=#FFFFFF;strokeColor=#3949AB;arcSize=14;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dI0JzHXBnpPs2hffmBnN-4" value="&lt;b&gt;Step 2: Inventory Tenant&lt;/b&gt;&lt;br&gt;(Read-Only API Calls)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D47A1;fontColor=#FFFFFF;strokeColor=#1565C0;arcSize=14;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dI0JzHXBnpPs2hffmBnN-5" value="&lt;div style=&#39;text-align:left;font-size:10px;&#39;&gt;&lt;b&gt;10 parallel MCP tool calls:&lt;/b&gt;&lt;br&gt;• zpa_list_app_connector_groups&lt;br&gt;• zpa_list_app_connectors&lt;br&gt;• zpa_list_server_groups&lt;br&gt;• zpa_list_segment_groups&lt;br&gt;• zpa_list_application_segments&lt;br&gt;• zpa_list_access_policy_rules&lt;br&gt;• zpa_list_forwarding_policy_rules&lt;br&gt;• zpa_list_timeout_policy_rules&lt;br&gt;• zpa_list_lss_configs&lt;br&gt;• zpa_list_lss_log_types&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;fontColor=#B0BEC5;strokeColor=#455A64;arcSize=8;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="300" width="230" height="170" as="geometry" />
        </mxCell>
        <mxCell id="dI0JzHXBnpPs2hffmBnN-6" value="&lt;b&gt;Pagination:&lt;/b&gt; auto-page if max 500 reached&lt;br&gt;&lt;b&gt;Errors:&lt;/b&gt; mark category &quot;Cannot Audit&quot;, continue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#37474F;fontColor=#CFD8DC;strokeColor=#546E7A;arcSize=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="480" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dI0JzHXBnpPs2hffmBnN-7" value="&lt;b&gt;Step 3: Score Findings&lt;/b&gt;&lt;br&gt;~26 checks across 7 categories" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B5E20;fontColor=#FFFFFF;strokeColor=#2E7D32;arcSize=14;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="570" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dI0JzHXBnpPs2hffmBnN-8" value="&lt;b&gt;Connectors&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:9px&#39;&gt;6 checks: N+1, geo, version drift, cert, enclave, LSS isolation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;strokeColor=#43A047;arcSize=10;fontSize=10;" vertex="1" parent="1">
