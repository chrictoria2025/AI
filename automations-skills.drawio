        <mxCell id="arM-87f5tBUBMfA-Q8R3-73" value="&lt;b&gt;Step 7: Verify &amp; Summarize&lt;/b&gt;&lt;br&gt;LLM calls GET on every resource,&lt;br&gt;presents dependency map to admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;fontSize=11;" parent="1" vertex="1">
