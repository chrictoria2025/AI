        <mxCell id="dI0JzHXBnpPs2hffmBnN-48" value="&lt;b&gt;Zero Tenant Mutation Risk&lt;/b&gt;&lt;br&gt;Fully read-only — safe to run anytime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B5E20;fontColor=#FFFFFF;strokeColor=#388E3C;arcSize=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="1100" width="260" height="45" as="geometry" />
