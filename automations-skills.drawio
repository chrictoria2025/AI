        <mxCell id="efOsK9inqy8JIb5-7ex9-44" value="&lt;b&gt;🔧 Explicit Tool Binding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Each step maps to exact API calls&lt;br&gt;(e.g., zia_url_lookup, get_zia_users)&lt;br&gt;No hallucinated tool names&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#6a1b9a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="930" y="305" width="260" height="70" as="geometry" />
