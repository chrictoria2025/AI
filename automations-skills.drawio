        <mxCell id="arM-87f5tBUBMfA-Q8R3-53" value="&lt;b&gt;Benefit:&lt;/b&gt; LLM checks existing&lt;br&gt;resources before creating →&lt;br&gt;avoids duplication &amp; sprawl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=2;fontSize=10;" parent="1" vertex="1">
