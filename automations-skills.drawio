        <mxCell id="arM-87f5tBUBMfA-Q8R3-65" value="&lt;b&gt;Step 6: Create Access Policy Rule&lt;/b&gt;&lt;br&gt;LLM looks up SCIM groups / SAML attrs&lt;br&gt;then creates ALLOW / DENY rule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;" parent="1" vertex="1">
