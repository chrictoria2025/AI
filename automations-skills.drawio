        </mxCell>
        <mxCell id="DbW1IiuRQzn9Q2EnQdVx-29" value="2. Key Vault &lt;b&gt;RBAC grant&lt;/b&gt;&lt;br&gt;targets managed identity&lt;br&gt;(must propagate before VM boot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="DbW1IiuRQzn9Q2EnQdVx-27">
          <mxGeometry x="20" y="105" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="DbW1IiuRQzn9Q2EnQdVx-30" value="3. Pre-create KV secrets&lt;br&gt;with &lt;b&gt;&quot;PENDING&quot; placeholder&lt;/b&gt;&lt;br&gt;(ignore_changes on value)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="DbW1IiuRQzn9Q2EnQdVx-27">
          <mxGeometry x="20" y="180" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="DbW1IiuRQzn9Q2EnQdVx-31" value="4. &lt;b&gt;VM boots&lt;/b&gt; (depends_on KV)&lt;br&gt;user_data_zscaler.sh runs:&lt;br&gt;• Install Azure CLI (dnf/yum)&lt;br&gt;• az login --identity&lt;br&gt;• Write OAuth code → KV secret&lt;br&gt;• Retry ~20× for RBAC consistency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="DbW1IiuRQzn9Q2EnQdVx-27">
