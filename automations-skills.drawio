        <mxCell id="IybVh6bIDGtyAEBsr_gW-1" value="&lt;b&gt;ZPA: Troubleshoot App Connector&lt;/b&gt;&lt;br&gt;How the SKILL.md Instructs the LLM" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="570" y="120" width="450" height="50" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-2" value="&lt;b&gt;Administrator&lt;/b&gt;" style="shape=mxgraph.basic.rect;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="180" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-3" value="&lt;b&gt;LLM (Claude)&lt;/b&gt;" style="shape=mxgraph.basic.rect;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="180" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-4" value="&lt;b&gt;ZPA API (MCP)&lt;/b&gt;" style="shape=mxgraph.basic.rect;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="180" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-5" value="&lt;b&gt;Output / Benefits&lt;/b&gt;" style="shape=mxgraph.basic.rect;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="180" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-6" value="Reports problem:&lt;br&gt;• Connector down&lt;br&gt;• Not enrolling&lt;br&gt;• Upgrade failed&lt;br&gt;• High CPU/mem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="250" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-7" value="&lt;b&gt;Step 1: Gather Issue Details&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Collect: connector name/group,&lt;br&gt;symptom, timeline, cloud name,&lt;br&gt;recent changes, scope (one/many)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="245" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-6" target="IybVh6bIDGtyAEBsr_gW-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-9" value="&lt;b&gt;Step 1.5: Config Pre-Flight Checks&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Validate against ZPA Baseline:&lt;br&gt;• AC group co-located with apps?&lt;br&gt;• N+1 connector redundancy?&lt;br&gt;• SIPA/LSS isolated in own groups?&lt;br&gt;• Outbound connectivity OK?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="385" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-7" target="IybVh6bIDGtyAEBsr_gW-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-11" value="⚠ LLM flags what API&lt;br&gt;&lt;b&gt;cannot&lt;/b&gt; check:&lt;br&gt;live CPU/mem/throughput&lt;br&gt;→ directs admin to&lt;br&gt;hypervisor metrics" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="385" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-12" style="dashed=1;rounded=1;strokeColor=#999999;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-9" target="IybVh6bIDGtyAEBsr_gW-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-13" value="✅ &lt;b&gt;Benefit:&lt;/b&gt; Catches&lt;br&gt;misconfig before&lt;br&gt;deep-diving on&lt;br&gt;symptoms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1040" y="395" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-14" style="dashed=1;rounded=1;strokeColor=#9673a6;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-11" target="IybVh6bIDGtyAEBsr_gW-13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-15" value="&lt;b&gt;Step 2: Inspect Connector &amp;&amp; Group&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Check runtime_status, version,&lt;br&gt;last_broker_connect_time,&lt;br&gt;control_channel_status,&lt;br&gt;group enabled/upgrade window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="540" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-9" target="IybVh6bIDGtyAEBsr_gW-15">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-17" value="&lt;b&gt;MCP API Calls:&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;zpa_list_app_connectors()&lt;br&gt;zpa_get_app_connector()&lt;br&gt;zpa_list_app_connector_groups()&lt;br&gt;zpa_get_app_connector_group()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="710" y="540" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-15" target="IybVh6bIDGtyAEBsr_gW-17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-19" value="&lt;b&gt;Step 3: Check Provisioning Keys&lt;/b&gt;&lt;br&gt;&lt;hr&gt;#1 cause of enrollment failure&lt;br&gt;• max_usage exhausted?&lt;br&gt;• key enabled?&lt;br&gt;• correct component_id?&lt;br&gt;• expired?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="685" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-15" target="IybVh6bIDGtyAEBsr_gW-19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-21" value="&lt;b&gt;MCP API Calls:&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;zpa_list_provisioning_keys()&lt;br&gt;zpa_get_provisioning_key()&lt;br&gt;&lt;i&gt;Can also:&lt;/i&gt;&lt;br&gt;zpa_update_provisioning_key()&lt;br&gt;zpa_create_provisioning_key()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="710" y="685" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-19" target="IybVh6bIDGtyAEBsr_gW-21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-23" value="✅ &lt;b&gt;Benefit:&lt;/b&gt; LLM can&lt;br&gt;auto-remediate by&lt;br&gt;increasing max_usage&lt;br&gt;or creating new key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1040" y="700" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-24" style="dashed=1;rounded=1;strokeColor=#9673a6;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-21" target="IybVh6bIDGtyAEBsr_gW-23">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-25" value="&lt;b&gt;Step 4: Check Server Groups &amp;&amp;&lt;br&gt;Application Segments&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Verify infrastructure chain:&lt;br&gt;App Segment → Server Group&lt;br&gt;→ Connector Group → Connector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="830" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-26" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-19" target="IybVh6bIDGtyAEBsr_gW-25">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-27" value="&lt;b&gt;MCP API Calls:&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;zpa_list_server_groups()&lt;br&gt;zpa_get_server_group()&lt;br&gt;zpa_list_application_segments()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="710" y="835" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-25" target="IybVh6bIDGtyAEBsr_gW-27">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-29" value="&lt;b&gt;Step 5:&lt;/b&gt;&lt;br&gt;Classify&lt;br&gt;Symptom" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="425" y="990" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-30" style="edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-25" target="IybVh6bIDGtyAEBsr_gW-29">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-31" value="&lt;b&gt;5A: Enrollment Failure&lt;/b&gt;&lt;br&gt;&lt;hr&gt;1. Provisioning key issues&lt;br&gt;2. DNS resolution failure&lt;br&gt;3. Network / firewall&lt;br&gt;4. Certificate / NTP skew&lt;br&gt;5. VM clone/migration&lt;br&gt;&lt;br&gt;&lt;i&gt;→ Wipe &amp; re-provision procedure&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="70" y="1150" width="195" height="140" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-32" value="&lt;b&gt;5B: Upgrade Failure&lt;/b&gt;&lt;br&gt;&lt;hr&gt;1. Check version mismatch&lt;br&gt;2. Connectivity to dist/yum&lt;br&gt;3. Revert to default version&lt;br&gt;4. Full rebuild fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="310" y="1150" width="175" height="110" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-33" value="&lt;b&gt;5C: PSE Connectivity&lt;/b&gt;&lt;br&gt;&lt;hr&gt;1. DNS check (co2br.*)&lt;br&gt;2. ICMP / TCP 443 check&lt;br&gt;3. TLS cert inspection&lt;br&gt;4. Packet capture analysis&lt;br&gt;5. Firewall allow-list verify" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="530" y="1150" width="175" height="120" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-34" value="&lt;b&gt;5D: High CPU / Mem / Disk&lt;/b&gt;&lt;br&gt;&lt;hr&gt;1. Identify top consumer&lt;br&gt;2. Normalize CPU by cores&lt;br&gt;3. Check internal mem stats&lt;br&gt;4. Find disk space culprits&lt;br&gt;5. Scaling recommendations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="750" y="1150" width="175" height="120" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-35" value="NOT_ENROLLED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-29" target="IybVh6bIDGtyAEBsr_gW-31">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="170" y="1040" />
              <mxPoint x="170" y="1150" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-36" value="version&lt;br&gt;mismatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-29" target="IybVh6bIDGtyAEBsr_gW-32">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="IybVh6bIDGtyAEBsr_gW-37" value="DISCONNECTED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-29" target="IybVh6bIDGtyAEBsr_gW-33">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="1040" />
