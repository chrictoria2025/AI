        </mxCell>
        <mxCell id="dI0JzHXBnpPs2hffmBnN-9" value="&lt;b&gt;Server Groups&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:9px&#39;&gt;3 checks: dynamic discovery, no AC group, overly broad&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D32;fontColor=#FFFFFF;strokeColor=#43A047;arcSize=10;fontSize=10;" vertex="1" parent="1">
