        <mxCell id="IybVh6bIDGtyAEBsr_gW-38" value="high resource" style="edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=8;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="IybVh6bIDGtyAEBsr_gW-29" target="IybVh6bIDGtyAEBsr_gW-34">
