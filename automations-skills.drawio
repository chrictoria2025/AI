        <mxCell id="IybVh6bIDGtyAEBsr_gW-39" value="&lt;b&gt;CLI Commands (on connector host):&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot; size=&quot;1&quot;&gt;journalctl -u zpa-connector&lt;br&gt;dig co2br.&amp;lt;cloud&amp;gt;.net&lt;br&gt;openssl s_client -connect …&lt;br&gt;curl 127.0.0.1:9000/memory/status&lt;br&gt;ps aux --sort=-pcpu | head -5&lt;br&gt;df -h&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="970" y="1140" width="215" height="120" as="geometry" />
