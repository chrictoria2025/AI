        <mxCell id="XRrftiEZt8YmYHH-MKmY-15" value="&lt;b&gt;Lambda&lt;/b&gt;&lt;br&gt;inspector-finding-triage-multi&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666&quot;&gt;① Read Inspector findings (aggregated)&lt;br&gt;② Lookup asset context from DynamoDB&lt;br&gt;③ Calculate combined risk score&lt;br&gt;④ Create Jira tickets if score ≥ 80&lt;/font&gt;" style="outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=middle;verticalAlign=middle;align=left;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;labelPosition=right;" parent="XRrftiEZt8YmYHH-MKmY-2" vertex="1">
